+void VirtualDesktopManager::ensureCurrentInActivityMap(const QString &activityId)
+{
+    const VirtualDesktopSpatialMap &map = activeSpatialMap();
+    if (map.isEmpty() || !m_current || map.containsDesktop(m_current->id())) {
+        return;
+    }
+    VirtualDesktop *target = nullptr;
+    auto last = s_lastDesktopPerActivity.constFind(activityId);
+    if (last != s_lastDesktopPerActivity.constEnd()) {
+        VirtualDesktop *vd = desktopForId(last.value());
+        if (vd && map.containsDesktop(vd->id())) {
+            target = vd;
+        }
+    }
+    if (!target) {
+        for (VirtualDesktop *vd : qAsConst(m_desktops)) {
+            if (map.containsDesktop(vd->id())) {
+                target = vd;
+                break;
+            }
+        }
+    }
+    if (!target) {
+        return;
+    }
+    // Deferred: let the activity switch finish (window visibility, scripts)
+    // before changing desktop. Skip if the user switched again meanwhile.
+    const QString targetId = target->id();
+    QTimer::singleShot(0, this, [this, activityId, targetId]() {
+        if (currentActivityId() != activityId) {
+            return;
+        }
+        // Someone else (e.g. ActivityJumper's setCurrentDesktop right after its
+        // SetCurrentActivity) may already have picked a valid desktop: then
+        // leave it alone, only rescue the user if still outside the map.
+        if (m_current && activeSpatialMap().containsDesktop(m_current->id())) {
+            return;
+        }
+        VirtualDesktop *vd = desktopForId(targetId);
+        if (vd && vd != m_current && activeSpatialMap().containsDesktop(targetId)) {
+            qDebug() << "Activity switch: desktop" << (m_current ? m_current->x11DesktopNumber() : 0)
+                               << "not in activity map, moving to" << vd->x11DesktopNumber();
+            setCurrent(vd);
+        }
+    });
+}
